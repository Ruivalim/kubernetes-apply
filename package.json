{
  "name": "@ruivalim/kubernetes-apply",
  "version": "0.2.0",
  "description": "A custom Backstage scaffolder action to apply any Kubernetes resource.",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruivalim/kubernetes-apply.git",
    "directory": "."
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "tsc": "tsc"
  },
  "keywords": [
    "backstage",
    "apply",
    "kubectl",
    "kubernetes",
    "backstage-scaffolder",
    "backstage-custom-action",
    "backstage-plugin",
    "backstage-template"
  ],
  "author": "Rui Valim",
  "license": "Apache-2.0",
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/plugin-scaffolder-node": "^0.13.7",
    "@kubernetes/client-node": "^1.4.0",
    "yaml": "^2.8.2"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.15",
    "@backstage/types": "^1",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.8.0"
  },
  "bugs": {
    "url": "https://github.com/Ruivalim/kubernetes-apply/issues"
  },
  "homepage": "https://github.com/Ruivalim/kubernetes-apply#readme",
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@1.22.22"
}
