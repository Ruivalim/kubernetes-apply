{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Stable (>=1.0) patch and minor updates merge on their own once CI is green",
      "matchUpdateTypes": ["patch", "minor"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "description": "Backstage ships monthly and most packages are 0.x, where any bump can break. One PR, reviewed by hand.",
      "matchPackageNames": ["@backstage/**"],
      "groupName": "backstage",
      "automerge": false
    },
    {
      "description": "Majors always go through review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
