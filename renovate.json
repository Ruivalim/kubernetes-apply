{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep GitHub Actions updates together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Do not narrow peer dependency compatibility",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen"
    },
    {
      "description": "Backstage ships monthly and most packages are 0.x, where any bump can break. Its own PR, so it never blocks the other updates.",
      "matchPackageNames": [
        "@backstage/**"
      ],
      "groupName": "backstage"
    },
    {
      "description": "Stay on the @kubernetes/client-node major that Backstage itself uses, so apps install a single copy. Revisit when @backstage/plugin-kubernetes-backend moves to 2.x.",
      "matchPackageNames": [
        "@kubernetes/client-node"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
